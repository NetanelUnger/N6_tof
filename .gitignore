# Local downloads, reference PDFs, extracted SDKs, and backups.  The one
# exception is the shared educational firmware-update key: this project is a
# classroom/development system, not a production trust root.
/.local-dependencies/*
!/.local-dependencies/keys/
/.local-dependencies/keys/*
!/.local-dependencies/keys/firmware-update-p256-private.blob

# STM32CubeIDE and generated build output
/**/Debug/
/**/Release/
/**/Debug_*/
/**/Release_*/
/.metadata/
/RemoteSystemsTempFiles/

# Signed/programming artifacts are recreated by Tools/build_and_sign.ps1
/FlashImages/*
!/FlashImages/.gitkeep

# Local logs and temporary files
/Tools/.n6-debug/
*.log
*.tmp
*.bak
*.swp
*~

# Operating-system metadata
Thumbs.db
Desktop.ini
.DS_Store

# Local ML environment, captured measurements, trained/generated models and reports
/training/.venv/
/training/data/raw/*
!/training/data/raw/.gitkeep
/training/data/prepared/*
!/training/data/prepared/.gitkeep
/training/models/*
!/training/models/.gitkeep
/training/generated/*
!/training/generated/.gitkeep
/training/reports/*
!/training/reports/.gitkeep
/training/state/*
!/training/state/.gitkeep
/training/review/*
!/training/review/.gitkeep
/training/reset_log.json
/hil_tests/.venv*/
/hil_tests/results/*
!/hil_tests/results/.gitkeep
__pycache__/
*.pyc
