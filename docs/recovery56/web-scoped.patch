+  assert.equal(a.reception.validatedFrames,index+1)
+ }
+ a.reception.read(performance.now()+4000)
+ a.reset()
+ assert.equal(a.reception.validatedFrames,5) // retained across rate expiry/source reset; receptions, not unique IDs
+})
